    "code-runner.executorMap": {
        "javascript": "node",
        "php": "php",
        "python": "python3",
        "perl": "perl",
        "ruby": "ruby",
        "go": "go run",
        "java": "cd $dir && javac -encoding UTF-8 $fileName && java $fileNameWithoutExt",
        "c": "cd $dir && gcc -O2 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
        "cpp": "/home/huynguyen/mnt/cpp/cp/init/runner $fullFileName",
        // "cpp": "cd $dir && g++ -std=c++23 -O2 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
        "cs": "cd $dir && dotnet run"
    },
    "code-runner.runInTerminal": true,
    "workbench.colorTheme": "Dracula Theme",
    "editor.tokenColorCustomizations": {
        "[Dracula Theme]": {
            "textMateRules": [
                {
                    "scope": "entity.name.namespace.cpp",
                    "settings": {
                        "foreground": "#8BE9FD"
                    }
                },
                {
                    "scope": "storage.type",
                    "settings": {
                        "foreground": "#CC99FF"
                    }
                }
            ]
        }
    },
